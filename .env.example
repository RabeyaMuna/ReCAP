# =============================================================================
# CI-Repair Bench Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual API keys
#   source .env  # or: set -a && source .env && set +a
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API (for GPT models: gpt-4o-mini, gpt-5.4-mini, etc.)
# -----------------------------------------------------------------------------
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# -----------------------------------------------------------------------------
# OpenRouter API (for MiniMax, DeepSeek, Claude, and other models)
# -----------------------------------------------------------------------------
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model for memory construction (optional)
# Examples: openrouter/minimax/minimax-m2.5, openrouter/anthropic/claude-3.5-sonnet
MEMCI_LLM_MODEL=openrouter/minimax/minimax-m2.5

# -----------------------------------------------------------------------------
# HuggingFace Token (for dataset download from HuggingFace Hub)
# -----------------------------------------------------------------------------
# Get your token from: https://huggingface.co/settings/tokens
# Required for downloading the CI-Repair dataset
HUGGINGFACE_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN_HERE

# -----------------------------------------------------------------------------
# GLM API (for GLM-5.2 model via Z.ai Platform) - OPTIONAL
# -----------------------------------------------------------------------------
# Get your key from: https://z.ai
# Only needed if using GLM models for decomposition
GLM_API_KEY=YOUR_GLM_API_KEY_HERE
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL_NAME=glm-5.2

# Alternative Z.ai configuration (if using different naming)
ZAI_API_KEY=YOUR_ZAI_API_KEY_HERE
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# -----------------------------------------------------------------------------
# DeepSeek API (if using DeepSeek directly instead of via OpenRouter) - OPTIONAL
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY_HERE
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# -----------------------------------------------------------------------------
# Anthropic API (if using Claude directly instead of via OpenRouter) - OPTIONAL
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE

# -----------------------------------------------------------------------------
# Experiment Configuration (Optional)
# -----------------------------------------------------------------------------
# Override default models for specific experiments
# DEFAULT_PLAN_MODEL=minimax2.5
# DEFAULT_PATCH_MODEL=minimax2.5
# DEFAULT_DECOMPOSITION_MODEL=glm-5.2

# -----------------------------------------------------------------------------
# LiteLLM Configuration (Advanced)
# -----------------------------------------------------------------------------
# Point to your LiteLLM config file
# LITELLM_CONFIG_PATH=./litellm_config.yaml

# Enable LiteLLM debugging (optional)
# LITELLM_LOG=DEBUG

# -----------------------------------------------------------------------------
# Runtime Configuration (Optional)
# -----------------------------------------------------------------------------
# Maximum workers for parallel execution
# MAX_WORKERS=4

# Cache directory for decomposition results
# DECOMPOSITION_CACHE_DIR=./data/decomposition_cache

# Results output directory
# RESULTS_DIR=./results

# =============================================================================
# SECURITY NOTES:
# =============================================================================
# 1. NEVER commit .env to git (it should be in .gitignore)
# 2. Keep your API keys secure and rotate them regularly
# 3. Use read-only tokens when possible
# 4. Monitor your API usage and costs
# 5. For production, consider using environment-specific .env files:
#    - .env.development
#    - .env.production
#    - .env.test
# =============================================================================
